# PyLazarus Environment Configuration
# Default mode is offline / zero-config replay mode (no API keys required)

PORT=8765
ENVIRONMENT=development
DEFAULT_REPLAY_MODE=true

# Local Open-Weight Inference (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_CHAT_MODEL=gemma4:e4b
GEMMA_EMBED_MODEL=embeddinggemma

# Tiger Data / TimescaleDB (Leave blank for automatic zero-config local SQLite fallback)
# TIGER_DATABASE_URL=postgresql://user:password@service.tigerdata.cloud:5432/pylazarus?sslmode=require
TIGER_DATABASE_URL=

# Browserbase / Stagehand (Optional: falls back to cached Wayback fixtures)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ElevenLabs (Optional: falls back to pre-warmed audio cache and browser speech synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Sentry Agent Tracing (Optional: traces are inspected in-app even without DSN)
SENTRY_DSN=

# Temporal Orchestration (Optional: falls back to direct in-process saga execution)
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
